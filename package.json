{
  "name": "chess-analyzer",
  "private": true,
  "version": "2.1.0",
  "homepage": "https://chessanalyzer.bariskisir.com",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "postinstall": "node scripts/prepare-engine.ts",
    "predev": "node scripts/prepare-engine.ts",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/prepare-engine.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0 && node scripts/check-comments.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sass": "^1.106.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
