{
  "name": "chess-analyzer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "postinstall": "node scripts/prepare-engine.ts",
    "predev": "node scripts/prepare-engine.ts",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/prepare-engine.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0 && node scripts/check-comments.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.2.6",
    "stockfish": "18.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sass": "^1.104.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13"
  }
}
